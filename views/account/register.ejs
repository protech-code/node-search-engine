<%- include('../partials/head') %>
<body class="home <%= ui.bgClass %>">
  <main class="login">
    <h1 class="logo small"><%= t('acc.register_title') %></h1>
    <% if (error) { %><p class="error"><%= error %></p><% } %>
    <form method="post" action="/account/register" class="stack">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <input name="email" type="email" placeholder="<%= t('acc.email') %>" required autofocus maxlength="254">
      <input name="password" type="password" placeholder="<%= t('acc.register_pw_ph') %>" required minlength="8" maxlength="200">
      <%- include('../partials/turnstile') %>
      <button type="submit"><%= t('acc.create_btn') %></button>
    </form>
    <p class="muted"><%= t('acc.have_account') %> <a href="/account/login"><%= t('acc.login_btn') %></a></p>
  </main>
  <%- include('../partials/footer') %>
</body></html>
